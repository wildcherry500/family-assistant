<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.family.assistant</groupId>
  <artifactId>family-assistant</artifactId>
  <version>1.0.0</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Tags excluded from a default `mvn test`. "llm" was already here; "gmail" added
         2026-08-09 because GmailIngestionTest is tagged @Tag("gmail"), NOT @Tag("llm"),
         so it was the one live-spend test still running by default — a real Gmail fetch
         plus up to 2 Gemini calls per fetched message, before the D4 cost gate. Opt back
         in explicitly: mvn test -Dexcluded.groups=llm   (or -Dexcluded.groups= for all). -->
    <excluded.groups>llm,gmail</excluded.groups>

    <!-- Empty by default. Maven does NOT substitute an unset ${env.X} — it passes the
         literal string "${env.GEMINI_API_KEY}" through, which is non-null, so every
         `assumeTrue(key != null)` guard passed and LLM/Gmail tests ran with a garbage
         key instead of skipping. The gemini-key profile below overrides this only when
         the env var is genuinely set. (Found 2026-08-03, fixed 2026-08-09.) -->
    <gemini.api.key></gemini.api.key>
  </properties>

  <profiles>
    <!-- Activates only when GEMINI_API_KEY is actually present in the environment. -->
    <profile>
      <id>gemini-key</id>
      <activation>
        <property>
          <name>env.GEMINI_API_KEY</name>
        </property>
      </activation>
      <properties>
        <gemini.api.key>${env.GEMINI_API_KEY}</gemini.api.key>
      </properties>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>nexus-releases</id>
      <url>https://nexus.redplanetlabs.com/repository/maven-public-releases</url>
    </repository>
    <repository>
      <id>clojars</id>
      <url>https://repo.clojars.org/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.rpl</groupId>
      <artifactId>rama</artifactId>
      <version>1.5.0</version>
    </dependency>
    <dependency>
      <groupId>com.rpl</groupId>
      <artifactId>agent-o-rama</artifactId>
      <version>0.8.0</version>
    </dependency>
    <dependency>
      <groupId>com.rpl</groupId>
      <artifactId>rama-helpers</artifactId>
      <version>0.10.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>1.8.0</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-google-ai-gemini</artifactId>
      <version>1.8.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-gmail</artifactId>
      <version>v1-rev20250331-2.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client</artifactId>
      <version>2.3.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.oauth-client</groupId>
      <artifactId>google-oauth-client-jetty</artifactId>
      <version>1.34.1</version>
    </dependency>
    <!-- Javalin 4.x uses Jetty 9, matching Rama's transitive Jetty version -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>4.6.4</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <GEMINI_API_KEY>${gemini.api.key}</GEMINI_API_KEY>
          </environmentVariables>
          <excludedGroups>${excluded.groups}</excludedGroups>
        </configuration>
      </plugin>
      <!-- Run FamilyAssistantApp in a real JVM: mvn compile exec:exec -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <executable>java</executable>
          <commandlineArgs>-cp %classpath com.family.assistant.FamilyAssistantApp</commandlineArgs>
        </configuration>
      </plugin>
      <!-- Fat jar is built by the package phase. Do NOT run `assembly:single` as a
           standalone goal: outside the lifecycle it emits a jar containing every
           dependency but NONE of this project's classes — right size, unusable for
           `rama deploy`. Keep this execution bound so `mvn clean package` is enough. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <id>make-fat-jar</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>







  </build>

</project>